# library system
name = input("enter your name: ")
books_list = ["science", "math", "english", "urdu", "history", "geography"]
again = "yes"

while again == "yes":
    print("1. see all books")
    print("2. borrow a book")
    print("3. return a book")
    choice=input("enter your choice")
    if choice=="1":
        print("available books are:", books_list)
    elif choice=="2":
        book=input("enter the book you want to borrow")
        if book in books_list:
            print("you have borrowed",book)
            books_list.remove(book)
        else:
            print("book is not available")
    elif choice=="3":
        book=input("enter the book you want to return")
        if book not in books_list:
            books_list.append(book)
            print("you have returned", book)
        else:
            print("book is already in the library")
    else:print("book is not available")
again=input("do you want to continue? yes/no").lower()
